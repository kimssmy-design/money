rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // entries 컬렉션: 로그인 기능이 없으므로 누구나 읽고 쓸 수 있음.
    // 대신 아래 조건으로 "가계부 항목 형식"이 아닌 데이터는 저장을 막아둠.
    match /entries/{entryId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['date','category','amount','method','writer']) &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.method in ['cash','card'] &&
        request.resource.data.writer in ['seonyeong','hyunwoo','gongyong'];
      allow update, delete: if false; // 앱에서 수정/삭제 기능을 아직 만들지 않았으므로 막아둠
    }

    // 그 외 모든 컬렉션은 기본적으로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
